{"id": "663194", "revid": "539651", "url": "https://vi.wikipedia.org/wiki?curid=663194", "title": "Praedora marshalli", "text": "Praedora marshalli là một loài bướm đêm thuộc họ Sphingidae. Loài này có ở xavan và vùng cây bụi ở miền bắc Nam Phi, Angola, Botswana và Zambia.\nChiều dài cánh trước khoảng 20 mm. Phía trên thân xám hơi nâu."}
{"id": "663195", "revid": "814981", "url": "https://vi.wikipedia.org/wiki?curid=663195", "title": "Praedora tropicalis", "text": "Praedora tropicalis là một loài bướm đêm thuộc họ Sphingidae. Loài này có ở xavan và vùng cây bụi từ Zambia tới Uganda và Kenya.\nChiều dài cánh trước khoảng 19–24 mm. Thân và cánh trước màu xám tối."}
{"id": "663196", "revid": "679363", "url": "https://vi.wikipedia.org/wiki?curid=663196", "title": "Praedora plagiata", "text": "Praedora plagiata là một loài bướm đêm thuộc họ Sphingidae. Loài này có ở savanna từ Zimbabwe tới Tanzania.\nChiều dài cánh trước khoảng 24–29 mm. Phía trên cánh trước màu xám với tông hồng nhạt."}
{"id": "663197", "revid": "814981", "url": "https://vi.wikipedia.org/wiki?curid=663197", "title": "Protaleuron", "text": "Protaleuron là một chi bướm đêm thuộc họ Sphingidae."}
{"id": "663198", "revid": "539651", "url": "https://vi.wikipedia.org/wiki?curid=663198", "title": "Protaleuron herbini", "text": "Protaleuron herbini là một loài bướm đêm thuộc họ Sphingidae. Loài này có ở Ecuador.\nChiều dài cánh trước khoảng 37 mm đối với con đực và 41 mm đối với con cái. Nó giống với \"Protaleuron rhodogaster\", nhưng phân biệt bởi rìa ngoài cánh trước đều hơn."}
{"id": "663199", "revid": "912316", "url": "https://vi.wikipedia.org/wiki?curid=663199", "title": "Protaleuron rhodogaster", "text": "Protaleuron rhodogaster là một loài bướm đêm thuộc họ Sphingidae. Loài này có ở Ecuador tới Bolivia.\nChiều dài cánh trước khoảng 34 mm đối với con đực. Phía trên thân màu ô liu hơi xanh lá cây. Con cái giống con đực nhưng có cánh trước rộng hơn."}
{"id": "663200", "revid": "686003", "url": "https://vi.wikipedia.org/wiki?curid=663200", "title": "Protambulyx astygonus", "text": "Protambulyx astygonus là một loài bướm đêm thuộc họ Sphingidae. Loài này có ở Bolivia, Paraguay và Brasil.\nSự miêu tả.\nSải cánh khoảng 100 mm. Nó gần giống loài \"Protambulyx goeldii\".\nSinh học.\nCá thể trưởng thành mọc cánh vào tháng 10 ở Bolivia. \nTại Paraguay, cá thể trưởng thành được ghi nhận vào tháng 6. \nCó thể có ít nhất hai thế hệ mỗi năm."}
